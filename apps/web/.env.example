# === WAJIB di produksi (server akan gagal kalau kurang) ===
# Turso database. url: `turso db show <db> --url`  token: `turso db tokens create <db>`
# Pakai token TANPA --expiration (atau yang panjang) untuk produksi — token
# kedaluwarsa = semua endpoint yang menyentuh DB balas 500/503.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Session SIWE, minimal 32 karakter acak: `openssl rand -base64 32`
SESSION_SECRET=

# === WAJIB di produksi (fitur rusak/aman-tertutup kalau kosong) ===
# Reown (WalletConnect) project ID — gratis di https://dashboard.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# Domain yang diizinkan untuk pesan SIWE (anti phishing-relay), pisah koma.
# Kosong = fallback ke host header (hanya untuk dev). Produksi WAJIB isi domain final,
# mis. indonesia-web3-hackathon.vercel.app
AUTH_ALLOWED_DOMAINS=

# URL produksi final (untuk metadataBase OG/canonical)
NEXT_PUBLIC_SITE_URL=

# === Opsional ===
# Anti-sybil: minimum jumlah transaksi on-chain (BNB Chain) untuk submit/buat tim.
# 0 = mati (default; jangan blokir builder wallet baru). Naikkan kalau spam jadi masalah.
SYBIL_MIN_TX=0
