# Google Sheets database (lihat README.md untuk panduan setup 5 menit)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste private key lengkap, ganti newline dengan \n (satu baris)
GOOGLE_PRIVATE_KEY=

# Kosongkan semua di atas saat development = otomatis pakai file lokal .data/submissions.json
# PERINGATAN: file lokal TIDAK jalan di Vercel (filesystem read-only).
# Produksi WAJIB mengisi tiga env var di atas, kalau tidak submission gagal tersimpan.

# Token ekspor CSV penjurian. Wajib diisi kalau mau memakai /api/submissions/export.
# Kosong = endpoint ekspor mati (gagal tertutup, bukan terbuka).
# Bikin token acak: openssl rand -hex 32
EXPORT_TOKEN=
